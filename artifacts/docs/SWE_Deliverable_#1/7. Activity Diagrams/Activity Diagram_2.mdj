						{
							"_type": "UMLTextView",
							"_id": "AAAAAAGhboIycD7YIiA=",
							"_parent": {
								"$ref": "AAAAAAGhYtgrBnq0Lq0="
							},
							"font": "Helvetica;22;0",
							"parentStyle": false,
							"left": 168,
							"top": 184,
							"width": 1256,
							"height": 222,
							"text": "This business process describes how an instructor prepares an exam and how the system verifies the student's identity before monitoring the exam session.\n\nThe process includes configuring exam settings, selecting the required monitoring level, applying registered accommodations, checking the student's device, and verifying the student's identity. If automatic identity verification fails, a live proctor performs a manual verification.\n\nDuring the exam, the system monitors the session, records flagged events, and notifies a live proctor about high-severity events when necessary.\n\nThe process also handles disconnections, including cases lasting more than 10 minutes, which require the instructor to decide whether a retake is needed.",
							"horzAlign": 2
						}
					]
				}
			],
