						{
							"_type": "UMLTextView",
							"_id": "AAAAAAGhbnjf320oqEc=",
							"_parent": {
								"$ref": "AAAAAAGhYtgrBnq0Lq0="
							},
							"fillColor": "#FFFFFF",
							"font": "Helvetica;24;0",
							"parentStyle": false,
							"left": 416,
							"top": 280,
							"width": 1448,
							"height": 240,
							"text": "This process describes how flagged events are reviewed after an exam and how suspected academic misconduct cases are handled.\n\nThe reviewer classifies each event as No Issue, Minor Issue, or Suspected Misconduct. Suspected misconduct cases are referred to the Academic Integrity Committee.\n\nThe student is notified in writing and has 7 days to respond. The committee makes its decision within 21 days of receiving the response, and the student may submit one appeal within 10 days of the decision.\n\nNo grade penalty is applied before the committee's decision. Recordings are retained and deleted according to applicable retention and appeal requirements.",
							"horzAlign": 2
						}
					]
				}
			],
